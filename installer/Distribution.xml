<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Armenian Phonetic</title>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <volume-check>
    <allowed-os-versions><os-version min="27.0"/></allowed-os-versions>
  </volume-check>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <choices-outline><line choice="armenian-phonetic"/></choices-outline>
  <choice id="armenian-phonetic" title="Armenian Phonetic" visible="false">
    <pkg-ref id="local.arsen.pkg.ArmenianPhonetic"/>
  </choice>
  <pkg-ref id="local.arsen.pkg.ArmenianPhonetic" version="1.0.0" auth="none">component.pkg</pkg-ref>
</installer-gui-script>
